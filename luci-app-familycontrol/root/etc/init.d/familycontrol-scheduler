#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# shellcheck disable=SC2034,SC3043

USE_PROCD=1
START=18
STOP=10

start_service() {
	/usr/libexec/familycontrol-firewall prepare ||
		logger -t familycontrol "Startup preparation failed; scheduler will retry"
	procd_open_instance
	procd_set_param command /usr/sbin/familycontrol-scheduler
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger familycontrol network
}
