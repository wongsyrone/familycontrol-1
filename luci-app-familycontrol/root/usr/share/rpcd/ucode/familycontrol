'use strict';

import { readfile, writefile, rename } from 'fs';
import { cursor } from 'uci';
import { RULES_FILE, build, store, inspect, refreshAddresses } from '/usr/share/familycontrol/enforcement.uc';
import { DEFAULT_SCHEDULE, validDate, localInstant, validateWindows, scheduleSettings, personAccess, nextTransition } from '/usr/share/familycontrol/schedule.uc';
import { networkNeighbors, discoverDevices } from '/usr/share/familycontrol/devices.uc';

const FIREWALL_PREFIX = 'familycontrol_';
const TELEMETRY_STATE = '/tmp/familycontrol-telemetry.json';
const DURATION_BOUNDS = [ 0.1, 0.25, 0.5, 1, 2, 5 ];
const PERSON_ID_PATTERN = /^[A-Za-z0-9_]+$/;
const MAC_PATTERN = /^[0-9A-F]{2}(:[0-9A-F]{2}){5}$/;
const NAME_PATTERN = /^[^[:cntrl:]]{1,40}$/;
const MUTATION_LOCK = '/var/lock/familycontrol';
const SCHEDULE_PATTERN = /^[01]{48}$/;
const NEXT_CHECK_FILE = '/var/run/familycontrol/next-check';
let enforcementError = '';
let reloadAttempted = false;

function fail(code, message) {
	return {
		ok: false,
		code,
		message
	};
}

function normalizeMac(value) {
	return uc(value || '');
}

function asList(value) {
	if (value == null)
		return [];
	return type(value) == 'array' ? value : [ value ];
}

function monotonicSeconds() {
	const value = clock(true);

	return value[0] + value[1] / 1000000000;
}

function recordAction(action, result, duration, firewallFailed) {
	let state = {};

	try {
		state = json(readfile(TELEMETRY_STATE) || '{}') || {};
	}
	catch (_) {
		state = {};
	}

	state.actions ||= {};
	const key = action + '.' + result;
	const metric = state.actions[key] || {
		count: 0,
		duration_sum: 0,
		buckets: [ 0, 0, 0, 0, 0, 0, 0 ]
	};
	let bucket = length(DURATION_BOUNDS);

	for (let i = 0; i < length(DURATION_BOUNDS); i++) {
		if (duration <= DURATION_BOUNDS[i]) {
			bucket = i;
			break;
		}
	}

	metric.count++;
	metric.duration_sum += duration;
	metric.buckets[bucket]++;
	state.actions[key] = metric;

	if (firewallFailed)
		state.firewall_reload_failures = (state.firewall_reload_failures || 0) + 1;

	/* Telemetry is best effort and must never decide the control result. */
	writefile(TELEMETRY_STATE, sprintf('%J', state));
}

function findPerson(ctx, personId) {
	let person = null;

	ctx.foreach('familycontrol', 'person', section => {
		if (section['.name'] == personId)
			person = section;
	});

	return person;
}

function personDevices(ctx, personId, connected) {
	let devices = [];

	ctx.foreach('familycontrol', 'device', section => {
		if (section.person == personId) {
			let mac = normalizeMac(section.mac);

			if (match(mac, MAC_PATTERN))
				push(devices, {
					id: section['.name'],
					name: section.name || mac,
					mac,
					connected: connected ? !!connected[mac] : null
				});
		}
	});

	return devices;
}

function firewallSection(personId) {
	return FIREWALL_PREFIX + personId;
}

function generatedFirewallSnapshot(ctx) {
	let sections = [];

	ctx.foreach('firewall', 'rule', section => {
		if (substr(section['.name'], 0, length(FIREWALL_PREFIX)) == FIREWALL_PREFIX)
			push(sections, section);
	});

	return sections;
}

function familySnapshot(ctx) {
	let sections = [];
	ctx.foreach('familycontrol', null, section => push(sections, section));
	return sections;
}

function restoreSections(ctx, packageName, sections, generatedOnly) {
	let names = [];
	ctx.foreach(packageName, null, section => {
		if (!generatedOnly ||
		    substr(section['.name'], 0, length(FIREWALL_PREFIX)) == FIREWALL_PREFIX)
			push(names, section['.name']);
	});
	for (let name in names)
		ctx.delete(packageName, name);

	for (let section in sections) {
		ctx.set(packageName, section['.name'], section['.type']);
		for (let option, value in section)
			if (substr(option, 0, 1) != '.')
				ctx.set(packageName, section['.name'], option, value);
	}
	ctx.commit(packageName);
}

function sameList(actual, expected) {
	if (type(actual) != 'array')
		actual = actual == null ? [] : [ actual ];
	if (length(actual) != length(expected))
		return false;
	for (let i = 0; i < length(expected); i++)
		if (actual[i] != expected[i])
			return false;
	return true;
}

function desiredFirewall(ctx, now) {
	const settings = ctx.get_all('familycontrol', 'main') || {};
	let desired = {};
	if (settings.enabled == '0')
		return desired;

	ctx.foreach('familycontrol', 'person', person => {
		if (personAccess(ctx, person, now).online)
			return;

		const devices = personDevices(ctx, person['.name']);
		if (!length(devices))
			return;

		const section = firewallSection(person['.name']);
		desired[section] = {
			name: 'Family Control: ' + person['.name'],
			src: settings.src_zone || 'lan',
			dest: settings.dest_zone || 'wan',
			proto: 'all',
			family: 'any',
			target: 'REJECT',
			enabled: '1',
			src_mac: map(devices, device => device.mac)
		};
	});
	return desired;
}

function firewallMatches(ctx, desired) {
	let seen = {};
	let matches = true;
	ctx.foreach('firewall', 'rule', section => {
		if (substr(section['.name'], 0, length(FIREWALL_PREFIX)) != FIREWALL_PREFIX)
			return;
		const expected = desired[section['.name']];
		if (!expected ||
		    section.name != expected.name || section.src != expected.src ||
		    section.dest != expected.dest || section.proto != expected.proto ||
		    section.family != expected.family || section.target != expected.target ||
		    section.enabled != expected.enabled ||
		    !sameList(section.src_mac, expected.src_mac))
			matches = false;
		seen[section['.name']] = true;
	});
	for (let name, _ in desired)
		if (!seen[name])
			matches = false;
	return matches;
}

function reconcile(ctx, prepareOnly, now) {
	reloadAttempted = false;
	enforcementError = '';
	const desired = desiredFirewall(ctx, now);
	const previousRules = readfile(RULES_FILE);
	let model;
	try {
		model = build(ctx, desired);
	}
	catch (error) {
		enforcementError = error.message || '' + error;
		return 1;
	}
	const changed = !firewallMatches(ctx, desired);

	if (changed) {
		let names = [];
		ctx.foreach('firewall', 'rule', section => {
			if (substr(section['.name'], 0, length(FIREWALL_PREFIX)) == FIREWALL_PREFIX)
				push(names, section['.name']);
		});
		for (let name in names)
			ctx.delete('firewall', name);

		for (let section, rule in desired) {
			ctx.set('firewall', section, 'rule');
			for (let option, value in rule)
				ctx.set('firewall', section, option, value);
		}
		if (!ctx.commit('firewall')) {
			enforcementError = 'Unable to save firewall configuration';
			return 1;
		}
	}

	try {
		if (previousRules != model.text)
			store(model.text);
		if (prepareOnly)
			return 0;
		if (changed || !inspect(model).ok) {
			reloadAttempted = true;
			if (system('/etc/init.d/firewall reload >/dev/null 2>&1') != 0)
				die('Firewall reload failed');
			const loaded = inspect(model);
			if (!loaded.ok)
				die(loaded.message);
		}
		else {
			refreshAddresses(model);
		}
		return 0;
	}
	catch (error) {
		enforcementError = error.message || '' + error;
		return 1;
	}
}

function mutate(change, prepareOnly) {
	if (system('/bin/lock -w ' + MUTATION_LOCK) != 0)
		return fail('busy', 'Another Family Control update is in progress');

	let ctx, previousFamily, previousFirewall, result, familyChanged = false;
	const previousRules = readfile(RULES_FILE);
	reloadAttempted = false;
	try {
		ctx = cursor();
		previousFamily = familySnapshot(ctx);
		previousFirewall = generatedFirewallSnapshot(ctx);
		const now = time();
		result = change ? change(ctx, now) : { ok: true, checked_at: now };
		if (result.ok) {
			if (change) {
				familyChanged = true;
				if (!ctx.commit('familycontrol'))
					die('Unable to save family configuration');
			}
			if (reconcile(ctx, prepareOnly, now) != 0)
				die(enforcementError || 'Firewall rejected the reconciled rules');
			let next = now + 30;
			if (ctx.get('familycontrol', 'main', 'enabled') != '0')
				ctx.foreach('familycontrol', 'person', person => {
					const transition = nextTransition(ctx, person, now);
					if (transition > now && transition < next)
						next = transition;
				});
			if (writefile(NEXT_CHECK_FILE + '.tmp', '' + next) == null ||
			    !rename(NEXT_CHECK_FILE + '.tmp', NEXT_CHECK_FILE))
				die('Unable to save the next schedule check');
			result.next_check = next;
		}
	}
	catch (error) {
		result = fail('firewall_reload_failed', error.message || '' + error);
		try {
			if (familyChanged)
				restoreSections(ctx, 'familycontrol', previousFamily, false);
			if (previousFirewall &&
			    sprintf('%J', generatedFirewallSnapshot(ctx)) != sprintf('%J', previousFirewall))
				restoreSections(ctx, 'firewall', previousFirewall, true);
			if (readfile(RULES_FILE) != previousRules)
				store(previousRules || '# No previous device restrictions\n');
			if (reloadAttempted && system('/etc/init.d/firewall reload >/dev/null 2>&1') != 0) {
				result.rollback_ok = false;
				result.message += '; firewall rollback could not be verified';
			}
		}
		catch (rollbackError) {
			result.rollback_ok = false;
			result.message += '; rollback failed: ' + (rollbackError.message || rollbackError);
		}
	}

	system('/bin/lock -u ' + MUTATION_LOCK);
	return result;
}

function validName(value) {
	return match(value || '', NAME_PATTERN);
}

function findDevice(ctx, deviceId) {
	let device = null;
	ctx.foreach('familycontrol', 'device', section => {
		if (section['.name'] == deviceId)
			device = section;
	});
	return device;
}

function duplicateMac(ctx, mac, exceptId) {
	let duplicate = false;
	ctx.foreach('familycontrol', 'device', section => {
		if (section['.name'] != exceptId && normalizeMac(section.mac) == mac)
			duplicate = true;
	});
	return duplicate;
}

function localClock(epoch) {
	const spec = localtime(epoch);
	return sprintf('%04d-%02d-%02d %02d:%02d:%02d',
		spec.year, spec.mon, spec.mday, spec.hour, spec.min, spec.sec);
}

function status() {
	const ctx = cursor();
	const now = time();
	const connected = networkNeighbors();
	const enabled = ctx.get('familycontrol', 'main', 'enabled') != '0';
	let enforcement;
	try {
		enforcement = inspect(build(ctx, desiredFirewall(ctx, now)));
	}
	catch (error) {
		enforcement = { ok: false, message: error.message || '' + error };
	}
	let people = [];

	ctx.foreach('familycontrol', 'person', section => {
		const access = personAccess(ctx, section, now);
		const schedule = scheduleSettings(section);
		const transition = enabled ? nextTransition(ctx, section, now) : 0;
		if (enabled && schedule.error && access.mode == 'schedule')
			enforcement = { ok: false, message: 'Invalid schedule: ' + schedule.error };
		push(people, {
			id: section['.name'],
			name: section.name || section['.name'],
			paused: enabled && !access.online,
			mode: access.mode,
			reason: enabled ? access.reason : { code: 'disabled', online: true },
			extra_until: access.extra_until,
			extra_until_local: access.extra_until ? localClock(access.extra_until) : '',
			next_transition: transition,
			next_transition_local: transition ? localClock(transition) : '',
			schedule_format: schedule.legacy ? 'legacy' : 'windows',
			schedule_policy: schedule.policy,
			schedule_default: schedule.legacy ? '' : schedule.policy == 'allow' ? 'block' : 'allow',
			windows: schedule.windows,
			schedule_error: schedule.error || '',
			school_schedule: section.school_schedule || DEFAULT_SCHEDULE,
			dayoff_schedule: section.dayoff_schedule || DEFAULT_SCHEDULE,
			school_night_cutoff: +(section.school_night_cutoff || 1320),
			dayoff_night_cutoff: +(section.dayoff_night_cutoff || 1320),
			devices: personDevices(ctx, section['.name'], connected)
		});
	});

	let timezone = 'UTC';
	ctx.foreach('system', 'system', section => {
		timezone = section.zonename || section.timezone || timezone;
	});
	return {
		ok: true,
		enabled,
		enforcement,
		router_now_local: localClock(now),
		router_timezone: timezone,
		people,
		calendar: {
			day_off: asList(ctx.get('familycontrol', 'main', 'day_off')),
			school_day: asList(ctx.get('familycontrol', 'main', 'school_day')),
			holiday: asList(ctx.get('familycontrol', 'main', 'holiday')),
			holiday_calendar: ctx.get('familycontrol', 'main', 'holiday_calendar') || '',
			holiday_valid_until: ctx.get('familycontrol', 'main', 'holiday_valid_until') || ''
		}
	};
}

function connectedDevices() {
	return {
		ok: true,
		devices: discoverDevices(cursor())
	};
}

function setPaused(request) {
	const personId = request.args.person;
	const paused = request.args.paused;
	const started = monotonicSeconds();
	const action = paused ? 'pause' : 'resume';

	if (!match(personId, PERSON_ID_PATTERN)) {
		recordAction(action, 'error', monotonicSeconds() - started, false);
		return fail('invalid_person', 'Invalid person identifier');
	}

	const result = mutate(ctx => {
		const person = findPerson(ctx, personId);
		if (!person)
			return fail('person_not_found', 'Person does not exist');

		const devices = personDevices(ctx, personId);
		if (paused && !length(devices))
			return fail('no_devices', 'Assign at least one valid device before pausing');

		ctx.set('familycontrol', personId, 'mode', paused ? 'paused' : 'online');
		ctx.set('familycontrol', personId, 'paused', paused ? '1' : '0');
		ctx.delete('familycontrol', personId, 'extra_until');
		return {
			ok: true,
			person: personId,
			paused,
			device_count: length(devices)
		};
	});

	recordAction(action, result.ok ? 'ok' : 'error',
		monotonicSeconds() - started, result.code == 'firewall_reload_failed');
	return result;
}

function savePerson(request) {
	const personId = request.args.person || '';
	const name = request.args.name || '';

	if (!validName(name))
		return fail('invalid_name', 'Name must be 1 to 40 printable characters');
	if (personId && !match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');

	return mutate(ctx => {
		let id = personId;
		if (id) {
			if (!findPerson(ctx, id))
				return fail('person_not_found', 'Person does not exist');
		}
		else {
			id = ctx.add('familycontrol', 'person');
			ctx.set('familycontrol', id, 'paused', '0');
			ctx.set('familycontrol', id, 'mode', 'online');
			ctx.set('familycontrol', id, 'schedule_policy', 'allow');
			ctx.set('familycontrol', id, 'schedule_windows', sprintf('%J', [
				{ repeat: 'daily', start: '06:00:00', end: '22:00:00' }
			]));
		}
		ctx.set('familycontrol', id, 'name', name);
		return { ok: true, person: id };
	});
}

function deletePerson(request) {
	const personId = request.args.person || '';
	if (!match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');

	return mutate(ctx => {
		if (!findPerson(ctx, personId))
			return fail('person_not_found', 'Person does not exist');

		let devices = [];
		ctx.foreach('familycontrol', 'device', section => {
			if (section.person == personId)
				push(devices, section['.name']);
		});
		for (let device in devices)
			ctx.delete('familycontrol', device);
		ctx.delete('familycontrol', personId);
		return { ok: true, person: personId, deleted_devices: length(devices) };
	});
}

function saveDevice(request) {
	const deviceId = request.args.device || '';
	const personId = request.args.person || '';
	const name = request.args.name || '';
	const mac = normalizeMac(request.args.mac);

	if (deviceId && !match(deviceId, PERSON_ID_PATTERN))
		return fail('invalid_device', 'Invalid device identifier');
	if (!match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');
	if (!validName(name))
		return fail('invalid_name', 'Name must be 1 to 40 printable characters');
	if (!match(mac, MAC_PATTERN))
		return fail('invalid_mac', 'Invalid MAC address');

	return mutate(ctx => {
		if (!findPerson(ctx, personId))
			return fail('person_not_found', 'Person does not exist');
		if (deviceId && !findDevice(ctx, deviceId))
			return fail('device_not_found', 'Device does not exist');
		if (duplicateMac(ctx, mac, deviceId))
			return fail('duplicate_mac', 'This MAC address is already assigned');

		const id = deviceId || ctx.add('familycontrol', 'device');
		ctx.set('familycontrol', id, 'name', name);
		ctx.set('familycontrol', id, 'mac', mac);
		ctx.set('familycontrol', id, 'person', personId);
		return { ok: true, device: id, person: personId, mac };
	});
}

function deleteDevice(request) {
	const deviceId = request.args.device || '';
	if (!match(deviceId, PERSON_ID_PATTERN))
		return fail('invalid_device', 'Invalid device identifier');

	return mutate(ctx => {
		if (!findDevice(ctx, deviceId))
			return fail('device_not_found', 'Device does not exist');
		ctx.delete('familycontrol', deviceId);
		return { ok: true, device: deviceId };
	});
}

function setMode(request) {
	const personId = request.args.person || '';
	const mode = request.args.mode || '';
	const started = monotonicSeconds();
	const action = mode == 'paused' ? 'pause' : mode == 'online' ? 'resume' : 'schedule';
	if (!match(personId, PERSON_ID_PATTERN)) {
		recordAction(action, 'error', monotonicSeconds() - started, false);
		return fail('invalid_person', 'Invalid person identifier');
	}
	if (mode != 'online' && mode != 'paused' && mode != 'schedule') {
		recordAction('mode', 'error', monotonicSeconds() - started, false);
		return fail('invalid_mode', 'Mode must be online, paused, or schedule');
	}

	const result = mutate(ctx => {
		if (!findPerson(ctx, personId))
			return fail('person_not_found', 'Person does not exist');
		ctx.set('familycontrol', personId, 'mode', mode);
		ctx.set('familycontrol', personId, 'paused', mode == 'paused' ? '1' : '0');
		ctx.delete('familycontrol', personId, 'extra_until');
		return { ok: true, person: personId, mode };
	});
	recordAction(action, result.ok ? 'ok' : 'error',
		monotonicSeconds() - started, result.code == 'firewall_reload_failed');
	return result;
}

function extraRequest(request, previewOnly) {
	const personId = request.args.person || '';
	const minutes = request.args.minutes;
	if (!match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');
	if (type(minutes) != 'int' || minutes < 1 || minutes > 1440)
		return fail('invalid_duration', 'Extra time must be a whole number from 1 to 1440 minutes');

	function calculate(ctx, now) {
		const person = findPerson(ctx, personId);
		if (!person)
			return fail('person_not_found', 'Person does not exist');

		const access = personAccess(ctx, person, now);
		let base = now;
		if (access.extra_until > now)
			base = access.extra_until;
		else if (access.mode == 'schedule' && access.online)
			base = nextTransition(ctx, person, now) || now;

		const until = base + minutes * 60;
		if (!previewOnly)
			ctx.set('familycontrol', personId, 'extra_until', `${until}`);
		return { ok: true, person: personId, from: base, from_local: localClock(base),
			extra_until: until, extra_until_local: localClock(until) };
	}
	return previewOnly ? calculate(cursor(), time()) : mutate(calculate);
}

function scheduleDraft(args) {
	if (args.format == 'windows') {
		const policy = args.policy;
		if (policy != 'allow' && policy != 'block')
			return fail('invalid_schedule', 'Policy must be allow or block');
		let windows;
		try {
			windows = validateWindows(args.windows);
		}
		catch (error) {
			return fail('invalid_schedule', error.message || '' + error);
		}
		return { ok: true, values: { schedule_policy: policy, schedule_windows: sprintf('%J', windows) } };
	}
	if (args.format && args.format != 'legacy')
		return fail('invalid_schedule', 'Unknown schedule format');
	const school = args.school_schedule || '', dayoff = args.dayoff_schedule || '';
	const schoolCutoff = +args.school_night_cutoff, dayoffCutoff = +args.dayoff_night_cutoff;
	if (!match(school, SCHEDULE_PATTERN) || !match(dayoff, SCHEDULE_PATTERN))
		return fail('invalid_schedule', 'Schedules must contain 48 half-hour slots');
	if (schoolCutoff < 0 || schoolCutoff > 1440 || schoolCutoff % 30 != 0 ||
	    dayoffCutoff < 0 || dayoffCutoff > 1440 || dayoffCutoff % 30 != 0)
		return fail('invalid_cutoff', 'Cutoffs must use half-hour intervals');
	return { ok: true, values: {
		school_schedule: school, dayoff_schedule: dayoff,
		school_night_cutoff: `${schoolCutoff}`, dayoff_night_cutoff: `${dayoffCutoff}`,
		schedule_windows: null, schedule_policy: null
	} };
}

function saveSchedule(request) {
	const personId = request.args.person || '', activate = request.args.activate;
	if (activate != null && type(activate) != 'bool')
		return fail('invalid_schedule', 'Activate must be a boolean');
	if (!match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');
	const draft = scheduleDraft(request.args);
	if (!draft.ok)
		return draft;
	return mutate(ctx => {
		if (!findPerson(ctx, personId))
			return fail('person_not_found', 'Person does not exist');
		for (let key, value in draft.values)
			if (value == null)
				ctx.delete('familycontrol', personId, key);
			else
				ctx.set('familycontrol', personId, key, value);
		if (activate) {
			ctx.set('familycontrol', personId, 'mode', 'schedule');
			ctx.set('familycontrol', personId, 'paused', '0');
			ctx.delete('familycontrol', personId, 'extra_until');
		}
		return { ok: true, person: personId };
	});
}

function previewSchedule(request) {
	const personId = request.args.person || '';
	if (!match(personId, PERSON_ID_PATTERN))
		return fail('invalid_person', 'Invalid person identifier');
	const draft = scheduleDraft(request.args);
	if (!draft.ok)
		return draft;
	const ctx = cursor(), person = findPerson(ctx, personId);
	if (!person)
		return fail('person_not_found', 'Person does not exist');
	let inspected = time();
	try {
		if (request.args.at_local)
			inspected = localInstant(request.args.at_local);
	}
	catch (error) {
		return fail('invalid_datetime', error.message || '' + error);
	}
	// Preview the automatic draft without changing a saved mode or extra-time override.
	const candidate = { ...person, ...draft.values, mode: 'schedule', extra_until: '0' };
	const access = personAccess(ctx, candidate, inspected);
	const transition = nextTransition(ctx, candidate, inspected);
	const spec = localtime(inspected);
	const end = timelocal({ ...spec, mday: spec.mday + 7, isdst: -1 });
	let segments = [], start = inspected;
	for (let i = 0; i < 32 && start < end; i++) {
		const next = i == 0 ? transition : nextTransition(ctx, candidate, start);
		const stop = next && next < end ? next : end;
		push(segments, { start, end: stop, start_local: localClock(start), end_local: localClock(stop),
			online: personAccess(ctx, candidate, start).online });
		start = stop;
	}
	return { ok: true, inspected, inspected_local: localClock(inspected), online: access.online,
		reason: access.reason, next_transition: transition, next_transition_local: transition ? localClock(transition) : '',
		preview_end: end, preview_end_local: localClock(end), segments, truncated: start < end };
}

function saveCalendar(request) {
	const dayOff = request.args.day_off;
	const schoolDay = request.args.school_day;
	if (type(dayOff) != 'array' || type(schoolDay) != 'array')
		return fail('invalid_calendar', 'Calendar exceptions must be lists');
	if (length(dayOff) > 100 || length(schoolDay) > 100)
		return fail('too_many_dates', 'Each exception list is limited to 100 dates');

	let seen = {};
	for (let kind, dates in { day_off: dayOff, school_day: schoolDay }) {
		for (let date in dates) {
			if (!validDate(date))
				return fail('invalid_date', 'Dates must use YYYY-MM-DD');
			if (seen[date])
				return fail('duplicate_date', 'A date cannot be both a school day and a day off');
			seen[date] = kind;
		}
	}

	return mutate(ctx => {
		ctx.delete('familycontrol', 'main', 'day_off');
		ctx.delete('familycontrol', 'main', 'school_day');
		if (length(dayOff))
			ctx.set('familycontrol', 'main', 'day_off', dayOff);
		if (length(schoolDay))
			ctx.set('familycontrol', 'main', 'school_day', schoolDay);
		return { ok: true, day_off: dayOff, school_day: schoolDay };
	});
}

function tick(request) {
	return mutate(null, request?.prepare_only);
}

